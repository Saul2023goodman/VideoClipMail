    "intention": "\u66ff\u4ee3\"\u56db\u4e2a\u529f\u80fd\u56db\u6bb5\u526a\u8f91\"\u7684\u7701\u955c\u65b9\u6848\uff1a\u4e00\u4e2a\u8fde\u7eed\u76f8\u673a\u628a\u56db\u4e2a\u89d2\u4e32\u6210\u4e00\u6761\u53c2\u89c2\u52a8\u7ebf\uff0c\u5149\u6807\u662f\u89c2\u4f17\u7684\u6ce8\u610f\u529b\u4ee3\u7406\u2014\u2014\u5b83\u5230\u54ea\u3001\u70b9\u54ea\uff0c\u89c2\u4f17\u5c31\u770b\u54ea\u3002\u7a7a\u95f4\u8fde\u7eed\u8ba9\u529f\u80fd\u4e4b\u95f4\u7684\u4f4d\u7f6e\u5173\u7cfb\u4e5f\u88ab\u987a\u5e26\u8bb0\u4f4f\u3002",
