    {
      "name": "spotlight-hero-card",
      "summary": "\u5173\u706f\u7684\u5267\u573a\u91cc\u4e00\u675f\u94a8\u4e1d\u805a\u5149\uff08\u5e26\u4f53\u79ef\u5149\u67f1\uff09\u626b\u8fc7\u9875\u9762\u9501\u5b9a\u4e00\u5f20\u5361\uff0c\u659c\u4fa7\u63a8\u8fdb\u540e\u5361\u7247\u5f39\u8d77\u60ac\u6d6e\u3001\u9999\u69df\u8272\u5149\u675f\u6cbf\u8f6e\u5ed3\u4e24\u5708\u3001\u8fde\u540c 3D \u6ce8\u8bb0\u4e00\u8d77\u8d34\u56de\u539f\u4f4d",
      "use": "\"\u5355\u4e00\u4e3b\u89d2\"\u5f0f\u4ea7\u54c1\u5f00\u573a\uff1b\u628a\u4e00\u4e2a\u6838\u5fc3\u5bf9\u8c61\uff08\u5361\u7247/\u6761\u76ee/\u6a21\u5757\uff09\u7acb\u6210\u5168\u7247\u4e3b\u89d2",
      "duration": "172f\uff08\u7ea6 5.7s\uff1b\u9501\u5b9a f34 \u2192 \u89e6\u5730 f142 \u2192 30f \u771f\u9759\u6b62 hold\uff09",
