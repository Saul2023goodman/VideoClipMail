    {
      "name": "card-flip-reveal",
      "summary": "\u529f\u80fd\u5361 3D \u7ffb\u9762\u63ed\u793a\u2014\u2014\u5361\u7247\u6cbf Y \u8f74\u7ffb 180\u00b0\uff0c\u6b63\u9762 UI \u7ffb\u5230\u4fa7\u68f1\u6700\u8584\u5904\u63a0\u8fc7\u4e00\u9053\u968f\u89d2\u5ea6\u79fb\u52a8\u7684\u53d7\u5149\uff0c\u80cc\u9762\u63ed\u51fa\u5927\u53f7\u7ed3\u8bba\u6570\u5b57\uff0c\u9010\u5f20\u9519\u5cf0\u626b\u8fc7\u6574\u6392",
      "use": "\"\u529f\u80fd\u2192\u6210\u679c\"\u7684\u6210\u5bf9\u53d9\u4e8b\uff1a\u4e00\u6392\u529f\u80fd\u5361\u9010\u5f20\u7ffb\u51fa\u5404\u81ea\u7684\u6307\u6807/\u7ed3\u8bba\uff1b\u5143\u7d20\u7ea7\u8f6c\u573a\u5361",
      "duration": "\u5168\u7a0b 150f\uff08~5s\uff0c\u542b hold\uff09\uff1b\u5355\u5361 4f \u9884\u5907 + 16f \u7ffb + ~10f \u5f39\u7c27\u843d\u5b9a\uff0c\u4e09\u5361\u9519\u5cf0 12f",
      "energy": "\u4e2d\u9ad8",
      "intention": "\u5e93\u5185\"\u7ffb\"\u5b57\u8f88\u5df2\u6709 wipe-transitions \u767e\u53f6\u7a97\uff08\u53f6\u7247\u9010\u6761\u7ffb\u9762\uff0c\u8bb2\u6362\u9875\uff09\u3002 \u672c\u5361\u662f**\u8bed\u4e49\u7ffb\u9762**\uff1a\u4e00\u5f20\u5361\u7684\u6b63\u53cd\u4e24\u9762\u662f\u4e00\u5bf9\u56e0\u679c\u2014\u2014\u6b63\u9762\u662f\u529f\u80fd\u754c\u9762\uff0c \u80cc\u9762\u662f\u5b83\u5e26\u6765\u7684\u6570\u5b57\u7ed3\u8bba\u3002\u7ffb\u9762\u52a8\u4f5c\u672c\u8eab \u5c31\u662f\"\u6240\u4ee5\u5462\uff1f\"\u7684\u56de\u7b54\uff0cApple bento \u6bb5\u843d\u7684\u6807\u51c6\u8bed\u6cd5\u3002\u9010\u5f20\u9519\u5cf0 10f \u626b\u8fc7 \u4e00\u6392\uff0c\u4e09\u5f20\u5361\u4e09\u4e2a\u6570\u5b57\u8282\u594f\u8bfb\u4f5c\"\u6210\u679c\u8fde\u62a5\"\u3002",
