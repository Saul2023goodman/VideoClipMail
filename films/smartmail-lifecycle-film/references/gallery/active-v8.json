    {
      "name": "scanline-annotate-focus",
      "summary": "\u4e00\u6761\u626b\u63cf\u7ebf\u81ea\u4e0a\u800c\u4e0b\u5300\u901f\u63a0\u8fc7\u5df2\u5b58\u5728\u7684\u9875\u9762\uff0c\u8d8a\u8fc7\u54ea\u5757\u533a\u5757\u7684\u4e0b\u7f18\uff0c\u54ea\u5757\u5c31\u88ab\u56db\u89d2\u53d6\u666f\u6846\u4ece\u5916\u6269\u5904\u5f39\u7c27\u6536\u62e2\u5bf9\u51c6\uff08\u4e00\u6b21\u8fc7\u51b2\uff09\uff0c\u968f\u540e\u8d34\u51fa\u4e00\u679a\u9010\u5b57\u6253\u51fa\u7684\u673a\u5668\u6807\u7b7e\uff0c\u9876\u90e8\u72b6\u6001\u884c\u540c\u6b65\u8ba1\u6570 00/06\u219206/06",
      "use": "\"AI \u6b63\u5728\u8bfb\u4f60\u7684\u9875\u9762/\u54c1\u724c\"\u7684\u5206\u6790\u955c\u5934\uff1b\u8bbe\u8ba1\u7cfb\u7edf/\u54c1\u724c\u89c4\u8303\u7684\u62c6\u89e3\u4ecb\u7ecd\uff1b\u4ea7\u54c1\u80fd\u529b\u7684\u81ea\u6211\u8bf4\u660e\u6bb5",
      "duration": "\u7ea65s\uff08150f@30fps\uff09",
      "energy": "\u4e2d\uff08\u673a\u68b0\u51b7\u9759\uff0c\u8282\u594f\u7531\u626b\u63cf\u7ebf\u5300\u901f\u63a8\u52a8\uff0c\u6807\u6ce8\u662f\u8282\u62cd\u70b9\uff09",
      "intention": "\u628a\"\u5206\u6790\"\u8fd9\u4ef6\u62bd\u8c61\u4e8b\u505a\u6210\u53ef\u89c1\u7684\u56e0\u679c\u94fe\uff1a\u626b\u63cf\u7ebf\u8d70\u5230\u54ea\uff0c\u90a3\u5757\u5c31\u88ab\u6846\u4f4f\u3001\u88ab \u547d\u540d\u3002\u89c2\u4f17\u8bfb\u7684\u662f\"\u673a\u5668\u7684\u89c6\u7ebf\"\uff0c\u6240\u4ee5\u626b\u63cf\u7ebf\u5fc5\u987b\u5300\u901f\u3001\u6807\u6ce8\u5fc5\u987b\u4e25\u683c\u6ede\u540e\u4e8e \u626b\u63cf\u7ebf\u8fc7\u5883\u2014\u2014**\u5148\u626b\u5230\u518d\u5f39\u6846**\uff0c\u987a\u5e8f\u4e00\u65e6\u9519\u4e71\u5c31\u53d8\u6210\u4e86\u9884\u5148\u7f16\u6392\u7684\u52a8\u753b\u3002",
