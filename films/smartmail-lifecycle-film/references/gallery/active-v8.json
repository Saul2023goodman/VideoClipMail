      "intention": "\u5f00\u573a\u53ea\u8bb2\u4e00\u4ef6\u4e8b\uff1a\u8fd9\u4e00\u5f20\u5361\u5c31\u662f\u4ea7\u54c1\u7684\u539f\u5b50\u5355\u4f4d\u3002\u805a\u5149\u706f\u66ff\u89c2\u4f17\u505a\u89c6\u7ebf\u5f15\u5bfc\uff0c\u5f39\u8d77\u60ac\u6d6e\u7ed9\u5b83\u4f53\u79ef\u548c\u91cd\u91cf\uff0c\u8f6e\u5ed3\u5149\u675f\u662f\"\u626b\u63cf/\u68c0\u89c6\"\u7684\u9690\u55bb\uff0c\u6700\u540e\u8d34\u56de\u539f\u4f4d\u8868\u793a\u5b83\u5c5e\u4e8e\u8fd9\u4e2a\u9875\u9762\u3002",
